# Store line endings as LF in the repository, check out native per platform.
* text=auto

# PowerShell keeps Windows line endings on checkout, which is what
# Windows PowerShell 5.1 expects.
*.ps1 text eol=crlf

# Binary files are never touched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
